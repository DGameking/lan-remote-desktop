{
  "name": "landesk",
  "version": "1.7.1",
  "description": "LanDesk - Windows 局域网跨平台远程桌面主控端（纯局域网、无服务端、无账号）",
  "main": "./out/main/index.js",
  "author": "LanDesk Team",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:vue": "vue-tsc --noEmit -p tsconfig.web.json",
    "test:unit": "vitest run",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "bonjour-service": "^1.2.1",
    "element-plus": "^2.9.1",
    "sql.js": "^1.12.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^45.4.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.1.10"
  }
}
